# MySQL – used by Docker and by DATABASE_URL when set from parts
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_DATABASE=stock_management

# Prisma (required). Use this format for MySQL:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"
# For local Docker:
DATABASE_URL="mysql://root:@localhost:3306/stock_management"

# JWT secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App URL (for links in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend email provider (required for forgot password and invitations)
RESEND_API_KEY=re_CLk88ujH_3Z16naYLtzoXDLxJnTKyi9gm
RESEND_FROM_EMAIL="BuildStock Security <security@realwalks.com>"

# Subscription automation
GRACE_PERIOD_DAYS=3

# Stripe billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_BATCH_SIZE=50
STRIPE_WEBHOOK_MAX_ATTEMPTS=12
STRIPE_WEBHOOK_RETRY_BASE_MS=60000
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel

# Billing observability
BILLING_ALERTS_SLACK_WEBHOOK_URL=
PLATFORM_METRICS_RATE_LIMIT_MAX=60
PLATFORM_METRICS_RATE_LIMIT_WINDOW_MS=60000
INTERNAL_PLATFORM_ACCESS_KEY=change-this-in-production

# Payment provider config encryption
PAYMENT_CONFIG_ENCRYPTION_KEY=change-this-very-long-secret

# Optional fallback PayPal env (used if DB config missing)
PAYPAL_MODE=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
